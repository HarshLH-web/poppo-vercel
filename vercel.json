
{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "headers": {
        "Location": "https://poppoagencyofficial.com/"
      },
      "status": 301
    },
    {
      "src": "^/agency/?$",
      "headers": {
        "Location": "https://poppoagencyofficial.com/"
      },
      "status": 301
    },
    {
      "src": "^/blog/?$",
      "headers": {
        "Location": "https://poppoagencyofficial.com/blogs"
      },
      "status": 301
    },
    {
      "src": "^/about/?$",
      "headers": {
        "Location": "https://poppoagencyofficial.com/about-us"
      },
      "status": 301
    },
    {
      "src": "^/privacy-policy/?$",
      "headers": {
        "Location": "https://poppoagencyofficial.com/privacy-policy"
      },
      "status": 301
    },
    {
      "src": "^/terms-conditions/?$",
      "headers": {
        "Location": "https://poppoagencyofficial.com/terms-and-conditions"
      },
      "status": 301
    },
    {
      "src": "^/blog/poppo-host-registration/?$",
      "headers": {
        "Location": "https://poppoagencyofficial.com/register/become-poppo-host"
      },
      "status": 301
    },
    {
      "src": "^/blog/become-poppo-agent/?$",
      "headers": {
        "Location": "https://poppoagencyofficial.com/how-to-become-a-poppo-agent"
      },
      "status": 301
    },
    {
      "src": "^/blog/poppo-coin-seller/?$",
      "headers": {
        "Location": "https://poppoagencyofficial.com/register/become-poppo-coin-seller"
      },
      "status": 301
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
